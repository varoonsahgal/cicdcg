# Lab 6 · Galactic Pizza: shared shell variables.
# Loaded by every new CloudShell tab (Part 2 adds it to ~/.bashrc). Safe to re-run at any time:
# every value is looked up by NAME, so resources you have not created yet simply show "None".
#   source ~/lab6/pizza.env && pizza_vars
export NN=${NN:?Set your number first, e.g.  export NN=07}
export AWS_DEFAULT_REGION=us-west-2
export P=participant-$NN
export CLUSTER=$P-pizza SVC=$P-pizza-svc FAMILY=$P-pizza
export ACCT=$(aws sts get-caller-identity --query Account --output text)
export IMAGE=$ACCT.dkr.ecr.us-west-2.amazonaws.com/pipeline-academy/galactic-pizza
export VPC=$(aws ec2 describe-vpcs --filters Name=isDefault,Values=true --query 'Vpcs[0].VpcId' --output text)
export SUBNETS=$(aws ec2 describe-subnets --filters Name=vpc-id,Values=$VPC Name=default-for-az,Values=true --query 'Subnets[].SubnetId' --output text | tr '\t' ',')
_sg()  { aws ec2 describe-security-groups --filters Name=group-name,Values=$1 --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null; }
_tg()  { aws elbv2 describe-target-groups --names $1 --query 'TargetGroups[0].TargetGroupArn' --output text 2>/dev/null || echo None; }
_rule(){ local l; l=$(aws elbv2 describe-listeners --load-balancer-arn "$ALB_ARN" --query "Listeners[?Port==\`$1\`].ListenerArn" --output text 2>/dev/null)
         [ -n "$l" ] && aws elbv2 describe-rules --listener-arn "$l" --query 'Rules[?!IsDefault].RuleArn | [0]' --output text 2>/dev/null || echo None; }
export ALB_SG=$(_sg $P-pizza-alb-sg) TASK_SG=$(_sg $P-pizza-task-sg)
export ALB_ARN=$(aws elbv2 describe-load-balancers --names $P-pizza-alb --query 'LoadBalancers[0].LoadBalancerArn' --output text 2>/dev/null || echo None)
export ALB_DNS=$(aws elbv2 describe-load-balancers --names $P-pizza-alb --query 'LoadBalancers[0].DNSName' --output text 2>/dev/null || echo None)
export BLUE_TG=$(_tg $P-pizza-blue) GREEN_TG=$(_tg $P-pizza-green)
export PROD_RULE=$(_rule 80) TEST_RULE=$(_rule 8080)
export INFRA_ROLE=arn:aws:iam::$ACCT:role/$P-ecs-infra-role
export ALARM=$P-pizza-5xx
export HOOK_FN=arn:aws:lambda:us-west-2:$ACCT:function:$P-menu-walker

# register a task-definition revision for one release and print its ARN:   register 1.1
register() {
  sed -e "s|@IMAGE@|$IMAGE:$1|" -e "s|@P@|$P|g" -e "s|@ACCT@|$ACCT|g" ~/lab6/taskdef.json > /tmp/td.json
  aws ecs register-task-definition --cli-input-json file:///tmp/td.json --query taskDefinition.taskDefinitionArn --output text
}
# the newest deployment's ARN (wait ~5 s after update-service: a new one takes a moment to be listed)
newest() { aws ecs list-service-deployments --cluster $CLUSTER --service $SVC --query 'serviceDeployments[0].serviceDeploymentArn' --output text; }
# print every stage change of the newest deployment; stops when it finishes or pauses for you
watch_deploy() {
  sleep 5; local a s h last=''; a=$(newest); echo "deployment ${a##*/}"
  while true; do
    s=$(aws ecs describe-service-deployments --service-deployment-arns $a --query 'serviceDeployments[0].[status,lifecycleStage,statusReason]' --output text | tr '\t' ' ')
    [ "$s" != "$last" ] && { echo "$(date +%T)  $s"; last=$s; }
    case $s in SUCCESSFUL*|ROLLBACK_SUCCESSFUL*|ROLLBACK_FAILED*|STOPPED*) return;; esac
    h=$(aws ecs describe-service-deployments --service-deployment-arns $a --query 'length(serviceDeployments[0].lifecycleHookDetails[?status==`AWAITING_ACTION`])' --output text 2>/dev/null)
    [ "$h" != "0" ] && [ "$h" != "None" ] && [ -n "$h" ] && { echo "$(date +%T)  ⏸  paused at a PAUSE hook: your move (Part 4)"; return; }
    sleep 5
  done
}
pizza_vars() { for v in NN P ALB_DNS ALB_SG TASK_SG BLUE_TG GREEN_TG PROD_RULE TEST_RULE SUBNETS; do printf '%-10s %s\n' $v "${!v}"; done; }
